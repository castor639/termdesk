<?xml version="1.0" encoding="UTF-8"?>
<!--
  termdesk defaults for LibreOffice: no first-run dialogs or info bars, no recovery dialogs or lock
  files, no AutoInput, word completion or AutoCorrect rewrites of typed text, maximized windows and
  no "Keep current format" question. Users can still change all of these in Tools > Options.
  ooSetupConnectionURL makes soffice listen for UNO on a local named pipe (/tmp/OSL_PIPE_<uid>_termdesk),
  not a TCP port, so scripts inside the sandbox can read and write documents with python3-uno:
  uno:pipe,name=termdesk;urp;StarOffice.ComponentContext
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
<dependency file="main"/>
<dependency file="calc"/>
<dependency file="writer"/>
<oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
 <node oor:name="Misc">
  <prop oor:name="FirstRun" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="UseLocking" oor:op="fuse"><value>false</value></prop>
 </node>
 <node oor:name="Save">
  <node oor:name="Document">
   <prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop>
  </node>
 </node>
 <node oor:name="AutoCorrect">
  <prop oor:name="UseReplacementTable" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="TwoCapitalsAtStart" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="CapitalAtStartSentence" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="SetInetAttribute" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ChangeOrdinalNumber" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ChangeDash" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="AddNonBreakingSpace" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ChangeAngleQuotes" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="CorrectAccidentalCapsLock" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ReplaceSingleQuote" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ReplaceDoubleQuote" oor:op="fuse"><value>false</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
 <node oor:name="Input">
  <prop oor:name="AutoInput" oor:op="fuse"><value>false</value></prop>
  <prop oor:name="ReplaceCellsWarning" oor:op="fuse"><value>false</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
 <node oor:name="AutoFunction">
  <node oor:name="Completion">
   <prop oor:name="Enable" oor:op="fuse"><value>false</value></prop>
  </node>
  <node oor:name="Format">
   <node oor:name="ByInput">
    <prop oor:name="Enable" oor:op="fuse"><value>false</value></prop>
   </node>
  </node>
 </node>
</oor:component-data>
<oor:component-data oor:name="Recovery" oor:package="org.openoffice.Office">
 <node oor:name="RecoveryInfo">
  <prop oor:name="Enabled" oor:op="fuse"><value>false</value></prop>
 </node>
 <node oor:name="AutoSave">
  <prop oor:name="Enabled" oor:op="fuse"><value>false</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:name="Setup" oor:package="org.openoffice">
 <node oor:name="Product">
  <prop oor:name="ooSetupLastVersion" oor:op="fuse"><value>7.4</value></prop>
  <prop oor:name="LastTimeGetInvolvedShown" oor:op="fuse"><value>4102444800</value></prop>
  <prop oor:name="LastTimeDonateShown" oor:op="fuse"><value>4102444800</value></prop>
 </node>
 <node oor:name="Office">
  <prop oor:name="ooSetupConnectionURL" oor:op="fuse"><value>pipe,name=termdesk;urp;StarOffice.ComponentContext</value></prop>
  <node oor:name="Factories">
   <node oor:name="com.sun.star.sheet.SpreadsheetDocument" oor:op="fuse">
    <prop oor:name="ooSetupFactoryWindowAttributes" oor:op="fuse"><value>0,26,1280,774;4;0,26,1280,774;</value></prop>
   </node>
   <node oor:name="com.sun.star.text.TextDocument" oor:op="fuse">
    <prop oor:name="ooSetupFactoryWindowAttributes" oor:op="fuse"><value>0,26,1280,774;4;0,26,1280,774;</value></prop>
   </node>
  </node>
 </node>
</oor:component-data>
</oor:data>
